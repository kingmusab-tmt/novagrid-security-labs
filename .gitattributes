# Keep Linux line endings on lab scripts/configs even when cloned on Windows
*.sh              text eol=lf
*.py              text eol=lf
*.conf            text eol=lf
*.csv             text eol=lf
Dockerfile        text eol=lf
Vagrantfile       text eol=lf
docker-compose.yml text eol=lf

# PowerShell checks out with Windows line endings
*.ps1 text eol=crlf
